generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- catalogue (written by the daily ingest job) ----------

model Store {
  id           String    @id // short key, e.g. "bronzesnake"
  name         String
  domain       String
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  products     Product[]
  outfits      Outfit[]
}

model Product {
  id            String                      @id @default(uuid())
  storeId       String
  store         Store                       @relation(fields: [storeId], references: [id])
  externalId    String
  title         String
  url           String
  imageUrl      String
  hoverImageUrl String? // second product photo, shown on hover
  colour        String? // one of the COLOURS in pipeline/ingest.py, for the colour filter
  price         Float
  compareAt     Float?
  category      String
  sizes         String[]
  inStock       Boolean                     @default(true)
  publishedAt   DateTime
  embedding     Unsupported("vector(768)")? // image fingerprint (Marqo FashionSigLIP)
  updatedAt     DateTime                    @updatedAt
  outfitItems   OutfitItem[]
  listItems     ListItem[]
  clicks        Click[]

  @@unique([storeId, externalId])
  @@index([storeId, inStock])
}

// ---------- user data ----------

model Outfit {
  id            String                      @id @default(uuid())
  userId        String
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  categories    String[]                    @default([]) // e.g. ["Tops"]; empty = all categories
  nameEmbedding Unsupported("vector(768)")? // text fingerprint of the name ("Floral tops"), filled in by the feed
  stores        Store[] // empty = all stores
  items         OutfitItem[]
  references    Reference[]
  createdAt     DateTime                    @default(now())

  @@index([userId])
}

enum ItemKind {
  EXAMPLE // added by the user as a style reference
  LIKE // hearted in the feed
  SKIP // dismissed in the feed
}

model OutfitItem {
  outfitId  String
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      ItemKind
  createdAt DateTime @default(now())

  @@id([outfitId, productId])
}

enum ReferenceStatus {
  PENDING // waiting for the embedding run
  READY
  FAILED // image couldn't be downloaded
}

// A style example from outside the catalogue: a link to any product page, Pinterest pin, Instagram post...
model Reference {
  id        String                      @id @default(uuid())
  outfitId  String
  outfit    Outfit                      @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  sourceUrl String? // the pasted link; empty for uploaded photos
  imageUrl  String
  status    ReferenceStatus             @default(PENDING)
  embedding Unsupported("vector(768)")?
  personal  Boolean                     @default(false) // likely a personal photo (taken on the user's phone, or a selfie)
  createdAt DateTime                    @default(now())

  @@index([outfitId])
}

// A named wishlist, e.g. "Sarah's wedding". Belongs to the user, so it can hold pieces from any outfit.
model List {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     ListItem[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model ListItem {
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([listId, productId])
}

enum ContactKind {
  GENERAL // general enquiry
  FEATURE // feature request
  STORE // from a store or brand (opt-outs, corrections, partnerships)
}

// Sent from the Contact page (also emailed to CONTACT_EMAIL when Resend is set up).
model ContactMessage {
  id        String      @id @default(uuid())
  kind      ContactKind
  name      String
  email     String
  message   String
  userId    String? // set when the sender was signed in
  createdAt DateTime    @default(now())
}

model Click {
  id        String   @id @default(uuid())
  userId    String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  outfitId  String?
  createdAt DateTime @default(now())
}

// ---------- Better Auth (shape required by better-auth) ----------

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  termsAcceptedAt DateTime? // when they agreed to the Terms of Use and Privacy Policy (set at sign-up)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]
  outfits         Outfit[]
  lists           List[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
