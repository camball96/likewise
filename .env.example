# Postgres. Locally: the Docker database (docker compose up -d). On Render: the database's Internal URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/styleit"

# Local only: Render's External URL, used to copy products into your local database (see README)
PROD_DATABASE_URL=""

# Better Auth: any long random string (e.g. `openssl rand -base64 32`), and the app's public URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional; the button only works once these are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Lets the app start the GitHub Actions ingest run when someone pastes a link
# (fine-grained token with "Actions: read and write" on this repo)
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO="camball96/styleit"
GITHUB_BRANCH="production"
