# Postgres. Locally: the Docker database (docker compose up -d). On Render: the database's Internal URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/likewise"

# Local only: Render's External URL, used to copy products into your local database (see README)
PROD_DATABASE_URL=""

# Better Auth: any long random string (e.g. `openssl rand -base64 32`), and the app's public URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional; the button only works once these are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 bucket for uploaded inspiration photos (see README → "Photo uploads (Cloudflare R2)")
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="likewise-uploads"
R2_PUBLIC_URL=""

# Fingerprint service for pasted links (pipeline/modal_app.py). The URL is printed by `modal deploy`;
# key and secret are a proxy auth token from Modal → Settings → Proxy Auth Tokens.
MODAL_EMBED_URL=""
MODAL_KEY=""
MODAL_SECRET=""

# Fallback when the fingerprint service is unavailable: the app starts the GitHub Actions ingest run instead
# (fine-grained token with "Actions: read and write" on this repo)
GITHUB_DISPATCH_TOKEN=""
# Only needed locally: on Render these come from its built-in RENDER_GIT_REPO_SLUG / RENDER_GIT_BRANCH
GITHUB_REPO="camball96/likewise"
GITHUB_BRANCH="production"

# Contact page emails (resend.com). Messages are always saved in the database; with a key they're also emailed.
RESEND_API_KEY=""
CONTACT_EMAIL="hello@lkws.au"
EMAIL_FROM="likewise <hello@lkws.au>"

# Cloudflare Turnstile spam check on the contact form (Cloudflare → Turnstile → Add widget). Leave empty to skip it.
# For local testing, Cloudflare's always-pass test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
